# Symlinked to the parent's node_modules for local typechecking; not part of the
# project, and committing a symlink to a directory is meaningless to git.
node_modules

# Transcripts and config live outside the tree (~/.local/state/warhead,
# ~/.config/warhead) and
# are deliberately never committed — they contain conversation content.
*.jsonl
.env

# Build output and the staging area used by scripts/build.mjs
dist/
.build/
tsconfig.tsbuildinfo
.DS_Store

# npm pack output. Belongs in the release assets, never in the repo —
# npm pack writes into the project root, so it must be ignored explicitly.
*.tgz

# Release staging: the tarball and its checksum sidecar, ready to upload as
# GitHub release assets. Ignored as a directory because the .sha256 sidecar
# would slip past the *.tgz rule above.
release/
