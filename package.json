{
  "name": "warhead",
  "version": "0.1.0-rc.4",
  "type": "module",
  "description": "Warhead — a private agentic coding tool for Ollama-hosted models. Zero runtime dependencies; runs on Node's native TypeScript stripping.",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "warhead-cli": "bin/warhead-cli.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    "test",
    "install.sh",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/cli/main.ts",
    "tools": "node src/cli/main.ts --tools",
    "scan": "node src/cli/main.ts --scan",
    "test": "node --test test/*.test.ts",
    "test:live": "node test/live/cases.ts",
    "test:install": "sh scripts/test-install.sh",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/check-encoding.mjs",
    "verify": "npm run check:encoding && tsc --noEmit && node --test test/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrokenPorkMachine/warhead.git"
  },
  "homepage": "https://github.com/BrokenPorkMachine/warhead#readme",
  "bugs": {
    "url": "https://github.com/BrokenPorkMachine/warhead/issues"
  },
  "author": "BrokenPorkMachine",
  "license": "UNLICENSED",
  "publishConfig": {
    "tag": "rc"
  },
  "keywords": [
    "agentic-coding",
    "ollama",
    "llm",
    "cli",
    "coding-agent"
  ]
}
