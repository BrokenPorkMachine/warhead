{
  "name": "warhead",
  "version": "0.1.0-rc.7",
  "type": "module",
  "description": "Warhead — a private, standalone coding agent for native MLX and GGUF models.",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "bin": {
    "warhead-cli": "bin/warhead-cli.js",
    "rea": "rea/scripts/rea.mjs",
    "rea-agents": "rea/scripts/rea.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    "test",
    "rea",
    "rea/dist",
    "native/warhead-runtime/Package.swift",
    "native/warhead-runtime/Package.resolved",
    "native/warhead-runtime/Sources",
    "install.sh",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:rea && node scripts/build.mjs",
    "build:rea": "npm run build:cached --prefix rea",
    "start": "node src/cli/main.ts",
    "tools": "node src/cli/main.ts --tools",
    "scan": "node src/cli/main.ts --scan",
    "test": "node --test test/*.test.ts",
    "test:live": "node test/live/cases.ts",
    "test:install": "sh scripts/test-install.sh",
    "typecheck": "tsc --noEmit",
    "check:encoding": "node scripts/check-encoding.mjs",
    "verify": "npm run check:encoding && tsc --noEmit && node --test test/*.test.ts"
  },
  "dependencies": {
    "rea-agents": "file:./rea"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrokenPorkMachine/warhead.git"
  },
  "homepage": "https://github.com/BrokenPorkMachine/warhead#readme",
  "bugs": {
    "url": "https://github.com/BrokenPorkMachine/warhead/issues"
  },
  "author": "BrokenPorkMachine",
  "license": "UNLICENSED",
  "publishConfig": {
    "tag": "rc"
  },
  "keywords": [
    "agentic-coding",
    "ollama",
    "llm",
    "cli",
    "coding-agent"
  ]
}
