{
  "name": "warhead",
  "version": "0.1.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Warhead \u2014 a private agentic coding tool for Ollama-hosted models. Zero runtime dependencies; runs on Node's native TypeScript stripping.",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "warhead": "bin/warhead.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    "test",
    "tsconfig.json",
    "tsconfig.build.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/cli/main.ts",
    "tools": "node src/cli/main.ts --tools",
    "scan": "node src/cli/main.ts --scan",
    "test": "node --test test/*.test.ts",
    "test:live": "node test/live/cases.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && node --test test/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrokenPorkMachine/warhead.git"
  },
  "keywords": [
    "agentic-coding",
    "ollama",
    "llm",
    "cli",
    "coding-agent"
  ]
}
